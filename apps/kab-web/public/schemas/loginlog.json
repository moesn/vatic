{
  "$schema": "../../node_modules/vatic/schema.json",
  "table": {
    "api": "/monitor/logininfor/list",
    "title": "登录日志",
    "keyField": "id",
    "nameField": "operName",
    "export": true,
    "columns": [
      {
        "field": "seq",
        "type": "seq",
        "width": 50
      },
      {
        "title": "用户名",
        "field": "account"
      },
      {
        "title": "登录时间",
        "field": "loginTime",
        "format": "datetime",
        "minWidth": 150
      },
      {
        "title": "IP地址",
        "field": "ipaddr",
        "minWidth": 120
      },
      {
        "title": "设备类型",
        "field": "deviceType",
        "width": 90
      },
      {
        "title": "浏览器",
        "field": "browser",
        "minWidth": 100
      },
      {
        "title": "操作系统",
        "field": "os",
        "minWidth": 200
      },
      {
        "title": "操作",
        "field": "msg",
        "minWidth": 90
      },
      {
        "title": "操作结果",
        "field": "status",
        "width": 90,
        "type": "Tag",
        "options": [
          {
            "label": "成功",
            "value": "0",
            "color": "success"
          },
          {
            "label": "失败",
            "value": "1",
            "color": "error"
          }
        ]
      }
    ],
    "search": [
      {
        "title": "用户账号",
        "field": "account",
        "type": "Input",
        "maxLength": 20
      },
      {
        "title": "IP地址",
        "field": "ipaddr",
        "type": "Input",
        "maxLength": 50
      },
      {
        "title": "操作结果",
        "field": "status",
        "type": "Select",
        "options": [
          {
            "label": "成功",
            "value": "0"
          },
          {
            "label": "失败",
            "value": "1"
          }
        ]
      }
    ]
  }
}
