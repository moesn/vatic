{
  "$schema": "../../node_modules/vatic/schema.json",
  "table": {
    "api": "/monitor/operlog/list",
    "title": "系统日志",
    "keyField": "id",
    "nameField": "operName",
    "export": true,
    "columns": [
      {
        "field": "seq",
        "type": "seq",
        "width": 50
      },
      {
        "title": "操作账号",
        "field": "operAccount"
      },
      {
        "title": "操作人员",
        "field": "operName"
      },
      {
        "title": "操作角色",
        "field": "operRoleNames",
        "minWidth": 100
      },
      {
        "title": "操作类型",
        "field": "businessType",
        "width": 90,
        "type": "Tag",
        "options": [
          {
            "label": "其它",
            "value": 0
          },
          {
            "label": "新增",
            "value": 1,
            "color": "success"
          },
          {
            "label": "修改",
            "value": 2,
            "color": "processing"
          },
          {
            "label": "删除",
            "value": 3,
            "color": "error"
          },
          {
            "label": "授权",
            "value": 4,
            "color": "warning"
          },
          {
            "label": "导出",
            "value": 5,
            "color": "warning"
          },
          {
            "label": "强退",
            "value": 6,
            "color": "error"
          },
          {
            "label": "生成代码",
            "value": 7
          },
          {
            "label": "清空数据",
            "value": 8,
            "color": "error"
          }
        ]
      },
      {
        "title": "操作描述",
        "field": "title",
        "minWidth": 160
      },
      {
        "title": "操作时间",
        "field": "operTime",
        "format": "datetime",
        "minWidth": 150
      },
      {
        "title": "错误消息",
        "field": "errorMsg",
        "minWidth": 160
      },
      {
        "title": "操作结果",
        "field": "status",
        "width": 80,
        "type": "Tag",
        "options": [
          {
            "label": "成功",
            "value": 0,
            "color": "success"
          },
          {
            "label": "失败",
            "value": 1,
            "color": "error"
          }
        ]
      }
    ],
    "search": [
      {
        "title": "操作描述",
        "field": "title",
        "type": "Input",
        "maxLength": 50
      },
      {
        "title": "操作人员",
        "field": "operName",
        "type": "Input",
        "maxLength": 20
      },
      {
        "title": "操作类型",
        "field": "businessType",
        "type": "Select",
        "options": [
          {
            "label": "新增",
            "value": 1
          },
          {
            "label": "修改",
            "value": 2
          },
          {
            "label": "删除",
            "value": 3
          }
        ]
      },
      {
        "title": "状态",
        "field": "status",
        "type": "Select",
        "options": [
          {
            "label": "成功",
            "value": 0
          },
          {
            "label": "失败",
            "value": 1
          }
        ]
      }
    ]
  }
}
